\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Low-rank and higher-rank deformation in a single reference pelvis.} Modes~1 and~2 (top) and modes~9 and~10 (bottom) are shown in anterior (left within each panel) and cranial (right) views. Grey denotes undeformed geometry and colour indicates relative displacement magnitude; displacement is enlarged to a maximum of 50\,mm in each panel for visualisation. Nonrigid share is $\|\mathbf  u_{\rm  nonrigid}\|_V^2/\|\mathbf  u\|_V^2$, computed after subtracting the best-fitting infinitesimal rigid-body motion of the whole pelvis. These percentages are shares of squared displacement norm, not deformation-energy fractions or measures of joint deformation. The complete atlas and polynomial-decomposition methods remain in Appendix~\ref {app:atlas}.}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:reference-contrast}{{2}{9}{\textbf {Low-rank and higher-rank deformation in a single reference pelvis.} Modes~1 and~2 (top) and modes~9 and~10 (bottom) are shown in anterior (left within each panel) and cranial (right) views. Grey denotes undeformed geometry and colour indicates relative displacement magnitude; displacement is enlarged to a maximum of 50\,mm in each panel for visualisation. Nonrigid share is $\|\mathbf u_{\rm nonrigid}\|_V^2/\|\mathbf u\|_V^2$, computed after subtracting the best-fitting infinitesimal rigid-body motion of the whole pelvis. These percentages are shares of squared displacement norm, not deformation-energy fractions or measures of joint deformation. The complete atlas and polynomial-decomposition methods remain in Appendix~\ref {app:atlas}}{figure.2}{}}
