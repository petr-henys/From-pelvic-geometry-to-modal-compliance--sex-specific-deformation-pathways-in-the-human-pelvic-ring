\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {Whole-pelvis deformation patterns of reference modes.} Anterior (left) and cranial (right) views show displacement magnitude from purple to yellow, scaled to a 50~mm maximum; grey geometry is undeformed. Each bar partitions the whole-pelvis nonrigid squared shape norm into fitted axial tension/compression, bending, transverse shear, torsion, and residual. Infinitesimal rigid-body translation and rotation are projected out before the decomposition. The decomposition covers the complete pelvic ring in three-dimensional Cartesian coordinates. Overlapping pattern subspaces are allocated using Shapley values. ``Fitted'' is the sum of the four family shares of nonrigid squared displacement norm.}}{28}{figure.12}\protected@file@percent }
\newlabel{fig:si-atlas}{{12}{28}{\textbf {Whole-pelvis deformation patterns of reference modes.} Anterior (left) and cranial (right) views show displacement magnitude from purple to yellow, scaled to a 50~mm maximum; grey geometry is undeformed. Each bar partitions the whole-pelvis nonrigid squared shape norm into fitted axial tension/compression, bending, transverse shear, torsion, and residual. Infinitesimal rigid-body translation and rotation are projected out before the decomposition. The decomposition covers the complete pelvic ring in three-dimensional Cartesian coordinates. Overlapping pattern subspaces are allocated using Shapley values. ``Fitted'' is the sum of the four family shares of nonrigid squared displacement norm}{figure.12}{}}
