\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Interpretable deformation pathways preview the spectrum's two organisational scales.} Median displacement fields across the cohort ($N{=}278$) are shown in anterior--posterior view with superimposed deformed wireframes. Colour scale indicates displacement magnitude from blue (minimum/fixed S1 facet) to red (maximum nodal displacement). Modes~1--3 define an order-locked low-rank rotational backbone (craniocaudal torsion, mediolateral nutation, anteroposterior obliquity). Modes~9--10 preview a compact clustered case where inlet opening is preserved at the subspace level rather than by a fixed rank label.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:modes-atlas}{{1}{5}{\textbf {Interpretable deformation pathways preview the spectrum's two organisational scales.} Median displacement fields across the cohort ($N{=}278$) are shown in anterior--posterior view with superimposed deformed wireframes. Colour scale indicates displacement magnitude from blue (minimum/fixed S1 facet) to red (maximum nodal displacement). Modes~1--3 define an order-locked low-rank rotational backbone (craniocaudal torsion, mediolateral nutation, anteroposterior obliquity). Modes~9--10 preview a compact clustered case where inlet opening is preserved at the subspace level rather than by a fixed rank label}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Population variability partitions the stiffness spectrum into an order-locked backbone and clustered higher ranks.} \textbf  {(A)} Consecutive relative spectral gaps $\mathrm  {gap}_{\rm  in}(i) = (\lambda _{i+1}-\lambda _i)/\lambda _i$ across the cohort ($N{=}278$); the dashed line marks the data-driven cluster threshold $\varepsilon _{\rm  in} \approx 0.131$ (25th percentile). \textbf  {(B)} Subject fraction exhibiting label exchange (blue) and unpaired pairing failures (grey; $\mathrm  {MAC}_{M_0} < 0.05$) per reference label. \textbf  {(C)} Eigenvalue variability (coefficient of variation, CoV) across the combined cohort (blue), shape-only cohort (orange), and material-only cohort (green).}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:spectral-dashboard}{{2}{6}{\textbf {Population variability partitions the stiffness spectrum into an order-locked backbone and clustered higher ranks.} \textbf {(A)} Consecutive relative spectral gaps $\mathrm {gap}_{\rm in}(i) = (\lambda _{i+1}-\lambda _i)/\lambda _i$ across the cohort ($N{=}278$); the dashed line marks the data-driven cluster threshold $\varepsilon _{\rm in} \approx 0.131$ (25th percentile). \textbf {(B)} Subject fraction exhibiting label exchange (blue) and unpaired pairing failures (grey; $\mathrm {MAC}_{M_0} < 0.05$) per reference label. \textbf {(C)} Eigenvalue variability (coefficient of variation, CoV) across the combined cohort (blue), shape-only cohort (orange), and material-only cohort (green)}{figure.2}{}}
