\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Subspace-level preservation is more stable than label assignment in the 9--10 block.} AP-inlet coupling is shown for rank mode~9, rank mode~10, and the canonical 9--10 subspace after stratifying cluster members by 9$\rightleftarrows $10 swap status. Label-level coupling redistributes between the two rank modes, whereas subspace-level coupling remains substantial in both groups. The shared 9--10 subspace remains interpretable across both groups.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:label-stability}{{4}{8}{\textbf {Subspace-level preservation is more stable than label assignment in the 9--10 block.} AP-inlet coupling is shown for rank mode~9, rank mode~10, and the canonical 9--10 subspace after stratifying cluster members by 9$\rightleftarrows $10 swap status. Label-level coupling redistributes between the two rank modes, whereas subspace-level coupling remains substantial in both groups. The shared 9--10 subspace remains interpretable across both groups}{figure.4}{}}
