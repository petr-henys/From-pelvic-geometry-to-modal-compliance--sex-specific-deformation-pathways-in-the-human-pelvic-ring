\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Linear toy model: stable ordering vs.\ near-degenerate mixing.} \textbf  {(a,\,b)} Stable-ordering scenario: $\lambda _{\pm }(\mu )$ well separated; mixing angle $\theta $ remains small. \textbf  {(c,\,d)} Near-degenerate scenario: near-degenerate mixing with character exchange with gap $2|c|$; $\theta $ passes through ${\approx }45^\circ $, exchanging mode identity. \textbf  {(e,\,f)} Diagnostic: $|\Delta (\mu )|$ vs.\ $\tau |c(\mu )|$; intersection signals near-degeneracy. Parameters as in Sec.~\ref {sec:2dof}; $\tau =2$.}}{14}{figure.1}\protected@file@percent }
\newlabel{fig:toy-grid}{{1}{14}{\textbf {Linear toy model: stable ordering vs.\ near-degenerate mixing.} \textbf {(a,\,b)} Stable-ordering scenario: $\lambda _{\pm }(\mu )$ well separated; mixing angle $\theta $ remains small. \textbf {(c,\,d)} Near-degenerate scenario: near-degenerate mixing with character exchange with gap $2|c|$; $\theta $ passes through ${\approx }45^\circ $, exchanging mode identity. \textbf {(e,\,f)} Diagnostic: $|\Delta (\mu )|$ vs.\ $\tau |c(\mu )|$; intersection signals near-degeneracy. Parameters as in Sec.~\ref {sec:2dof}; $\tau =2$}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Stochastic extension: population variability, hidden pathways, and task-dependent routing}{14}{subsection.4.3}\protected@file@percent }
\newlabel{sec:toy-stochastic}{{4.3}{14}{Stochastic extension: population variability, hidden pathways, and task-dependent routing}{subsection.4.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Stochastic toy cohort: variability, near-degeneracy, routing, and extremes.} \textbf  {(a)}~Hidden compliance pathways (3-DOF Schur complement) shift a subset of individuals toward the near-degenerate regime by changing the effective index $|\Delta ^{\mathrm  {eff}}|/|c^{\mathrm  {eff}}|$ relative to the ``bare'' $|\Delta |/|c|$. \textbf  {(b)}~Population distribution of $|\Delta ^{\mathrm  {eff}}|/|c^{\mathrm  {eff}}|$ with near-degenerate threshold $\tau $ (dashed). \textbf  {(c)}~Mixing angle $\theta $ vs.\ morphology proxy $\mu $ with swap marker overlaid (triangles): swap is a discrete manifestation of label fragility that can occur within a broader continuum of subspace rotation. \textbf  {(d)}~Sex-stratified prevalence of mixing ($z\le \tau $) and swap. \textbf  {(e)}~Task switching in load routing in the 3-DOF system: standing-like loading routes energy into a backbone mode, while parturition-like loading routes energy into the two-mode clustered subspace. \textbf  {(f)}~Within-cluster routing under parturition-like loading (energy partition ratio) modulates a toy upper-tail localization proxy, illustrating how tails can be sensitive to routing state inside a stable subspace. \emph  {Interpretive link:} the FE cohort results are the high-dimensional analogue of this picture---population variability can preserve a canalized backbone while recurrent near-degenerate subspaces remain functionally interpretable at the subspace level, with internal routing states that disproportionately modulate extremes.}}{15}{figure.2}\protected@file@percent }
\newlabel{fig:toy-pop-dashboard}{{2}{15}{\textbf {Stochastic toy cohort: variability, near-degeneracy, routing, and extremes.} \textbf {(a)}~Hidden compliance pathways (3-DOF Schur complement) shift a subset of individuals toward the near-degenerate regime by changing the effective index $|\Delta ^{\mathrm {eff}}|/|c^{\mathrm {eff}}|$ relative to the ``bare'' $|\Delta |/|c|$. \textbf {(b)}~Population distribution of $|\Delta ^{\mathrm {eff}}|/|c^{\mathrm {eff}}|$ with near-degenerate threshold $\tau $ (dashed). \textbf {(c)}~Mixing angle $\theta $ vs.\ morphology proxy $\mu $ with swap marker overlaid (triangles): swap is a discrete manifestation of label fragility that can occur within a broader continuum of subspace rotation. \textbf {(d)}~Sex-stratified prevalence of mixing ($z\le \tau $) and swap. \textbf {(e)}~Task switching in load routing in the 3-DOF system: standing-like loading routes energy into a backbone mode, while parturition-like loading routes energy into the two-mode clustered subspace. \textbf {(f)}~Within-cluster routing under parturition-like loading (energy partition ratio) modulates a toy upper-tail localization proxy, illustrating how tails can be sensitive to routing state inside a stable subspace. \emph {Interpretive link:} the FE cohort results are the high-dimensional analogue of this picture---population variability can preserve a canalized backbone while recurrent near-degenerate subspaces remain functionally interpretable at the subspace level, with internal routing states that disproportionately modulate extremes}{figure.2}{}}
