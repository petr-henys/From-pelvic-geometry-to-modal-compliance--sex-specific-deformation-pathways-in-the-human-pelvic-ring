\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces \textbf  {SIJ micromotion dashboard (population, precomputed kinematics).} \textbf  {(A)}~Load-case profile of SIJ global rotation and translation magnitudes (median with 10th--90th percentiles). \textbf  {(B)}~Directional translation deltas versus SP2 baseline, showing anisotropic rerouting across SP1 and LAB\textsubscript  {1}--LAB\textsubscript  {3}; SP2 is not plotted in this panel because $\Delta (\mathrm  {SP2})\equiv 0$ by definition. \textbf  {(C--E)}~Sex baseline under LAB\textsubscript  {1}--LAB\textsubscript  {3} (female vs.\ male medians with 10th--90th percentile spread). \textbf  {(F--H)}~Swap vs.\ no-swap median contrasts under LAB\textsubscript  {1}--LAB\textsubscript  {3} for key SIJ outputs. \textbf  {(I)}~Spearman coupling of SIJ metrics to operating-point and tail metrics ($\rho $, with * marking $p<0.05$). \textbf  {(J)}~Variance-channel ratios under LAB\textsubscript  {1}--LAB\textsubscript  {3}: shape-only/full and material-only/full. Together, the dashboard links SIJ-level motion anisotropy and tail-coupled operating states while confirming morphology-dominant between-subject SIJ variability in this cohort.}}{43}{figure.18}\protected@file@percent }
\newlabel{fig:sij-micromotion-dashboard}{{18}{43}{\textbf {SIJ micromotion dashboard (population, precomputed kinematics).} \textbf {(A)}~Load-case profile of SIJ global rotation and translation magnitudes (median with 10th--90th percentiles). \textbf {(B)}~Directional translation deltas versus SP2 baseline, showing anisotropic rerouting across SP1 and LAB\textsubscript {1}--LAB\textsubscript {3}; SP2 is not plotted in this panel because $\Delta (\mathrm {SP2})\equiv 0$ by definition. \textbf {(C--E)}~Sex baseline under LAB\textsubscript {1}--LAB\textsubscript {3} (female vs.\ male medians with 10th--90th percentile spread). \textbf {(F--H)}~Swap vs.\ no-swap median contrasts under LAB\textsubscript {1}--LAB\textsubscript {3} for key SIJ outputs. \textbf {(I)}~Spearman coupling of SIJ metrics to operating-point and tail metrics ($\rho $, with * marking $p<0.05$). \textbf {(J)}~Variance-channel ratios under LAB\textsubscript {1}--LAB\textsubscript {3}: shape-only/full and material-only/full. Together, the dashboard links SIJ-level motion anisotropy and tail-coupled operating states while confirming morphology-dominant between-subject SIJ variability in this cohort}{figure.18}{}}
