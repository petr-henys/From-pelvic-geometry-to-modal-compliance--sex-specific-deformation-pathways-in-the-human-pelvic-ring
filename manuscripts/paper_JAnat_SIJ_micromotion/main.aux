\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Model anatomy and load definitions.} (A) Pelvic assembly with schematic morphometric overlays; their drawn locations illustrate dimensions and are not quantitative landmark measurements. Green denotes the S1 constraint, orange the SIJ cartilage and purple the symphysis. (B) Exploded articulation and pelvis-aligned coordinate definitions; arrows illustrate axes, not measured trajectories. Rotations describe ilium relative to sacrum. (C) Bilateral and unilateral acetabular loads. (D) Independent ring, ischial and AP force pairs. Arrows represent applied global force directions; they do not demonstrate joint opening. The penalty approximates a fixed boundary.}}{9}{figure.caption.4}\protected@file@percent }
\newlabel{fig:overview}{{1}{9}{\textbf {Model anatomy and load definitions.} (A) Pelvic assembly with schematic morphometric overlays; their drawn locations illustrate dimensions and are not quantitative landmark measurements. Green denotes the S1 constraint, orange the SIJ cartilage and purple the symphysis. (B) Exploded articulation and pelvis-aligned coordinate definitions; arrows illustrate axes, not measured trajectories. Rotations describe ilium relative to sacrum. (C) Bilateral and unilateral acetabular loads. (D) Independent ring, ischial and AP force pairs. Arrows represent applied global force directions; they do not demonstrate joint opening. The penalty approximates a fixed boundary}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Corrected motion distributions.} Rotation-triplet norm, relative translation norm, absolute ML rotation and bilateral translation-magnitude asymmetry. Points are subjects; boxplots show medians and IQRs, with whiskers at 1.5 IQR. Female and male groups use vermilion and blue. Jitter is deterministic. No signed nutation direction is inferred.}}{10}{figure.caption.6}\protected@file@percent }
\newlabel{fig:loadprofiles}{{2}{10}{\textbf {Corrected motion distributions.} Rotation-triplet norm, relative translation norm, absolute ML rotation and bilateral translation-magnitude asymmetry. Points are subjects; boxplots show medians and IQRs, with whiskers at 1.5 IQR. Female and male groups use vermilion and blue. Jitter is deterministic. No signed nutation direction is inferred}{figure.caption.6}{}}
