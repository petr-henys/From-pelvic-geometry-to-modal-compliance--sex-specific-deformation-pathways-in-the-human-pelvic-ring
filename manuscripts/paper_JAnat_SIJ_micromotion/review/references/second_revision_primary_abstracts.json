      "issue": "18",
      "volume": "43",
      "journalIssueId": 2720151,
      "dateOfPublication": "2018 Sep",
      "monthOfPublication": 9,
      "yearOfPublication": 2018,
      "journal": {
        "medlineAbbreviation": "Spine (Phila Pa 1976)",
        "title": "Spine",
