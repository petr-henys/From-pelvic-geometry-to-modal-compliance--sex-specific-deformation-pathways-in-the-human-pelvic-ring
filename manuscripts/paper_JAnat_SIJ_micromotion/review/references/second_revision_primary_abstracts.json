    "journalInfo": {
      "issue": "2",
      "volume": "95",
      "journalIssueId": 2912484,
      "dateOfPublication": "2020 Mar",
      "monthOfPublication": 3,
      "yearOfPublication": 2020,
      "journal": {
        "medlineAbbreviation": "Anat Sci Int",
        "title": "Anatomical science international",
        "essn": "1447-073X",
